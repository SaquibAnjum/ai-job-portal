{
  "name": "ai-job-portal",
  "version": "1.0.0",
  "description": "Production-Ready AI-Powered Job Portal with Smart Resume Matching (MERN + Google Gemini)",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "node server/utils/seed.js"
  },
  "keywords": [
    "mern",
    "ai",
    "gemini",
    "job-portal",
    "resume-matching",
    "redux",
    "tailwind"
  ],
  "author": "Antigravity AI",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
